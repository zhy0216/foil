{
  "name": "@foil/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/check-config.ts && vite build --watch",
    "build": "bun scripts/check-config.ts && tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun scripts/check.ts",
    "package": "bun run build && bun scripts/package.ts",
    "icons": "bun scripts/icons.ts"
  },
  "dependencies": {
    "@foil/editor": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@foil/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "es-module-lexer": "2.1.0",
    "fflate": "0.8.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
