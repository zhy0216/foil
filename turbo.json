{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".node-version", ".npmrc"],
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["FOIL_E2E_BASE", "FOIL_E2E_PORT"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    }
  }
}
